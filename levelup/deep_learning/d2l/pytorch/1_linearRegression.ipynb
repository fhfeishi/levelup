   "source": [
    "def normal(x, mu, sigma):\n",
    "    p = 1/math.sqrt(2 * math.pi * sigma**2)\n",
    "    return p * np.exp(-0.5/sigma**2 * (x-mu)**2)\n",
    "\n"
   ]
